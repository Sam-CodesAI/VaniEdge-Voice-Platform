# ==============================================================================
# VANIEDGE VOICE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# Copy this file to .env.local for local Next.js development.
# For Cloudflare Workers, configure secrets via `wrangler secret put <KEY>`.
# NEVER commit production credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
CANONICAL_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. CARRIER TELEPHONY: TWILIO VOICE & MEDIA STREAMS
# ------------------------------------------------------------------------------
# Required for signature verification and inbound/outbound calls
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18149613703

# Optional Twilio API Key credentials (used for media stream bridge client)
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_twilio_api_secret_here

# Local testing override (set to true only for offline development without Twilio signatures)
ALLOW_INSECURE_DEV_WEBHOOKS=false

# ------------------------------------------------------------------------------
# 3. VOICE AI: ELEVENLABS CONVERSATIONAL AI & AWS POLLY
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here
ELEVENLABS_MODEL_ID=eleven_turbo_v2
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_INPUT_FORMAT=ulaw_8000
ELEVENLABS_OUTPUT_FORMAT=ulaw_8000

# AWS Polly credentials (optional, fallback TTS provider)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ------------------------------------------------------------------------------
# 4. SUB-SECOND FAILOVER WATCHDOG & EMERGENCY DISPATCH
# ------------------------------------------------------------------------------
FAILOVER_CONNECT_TIMEOUT_MS=1200
FAILOVER_TTFT_TIMEOUT_MS=1500
FALLBACK_HUMAN_NUMBER=+18005550199

# Notification recipient for priority voicemails and emergency alerts
ADMIN_NOTIFY_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# 5. PERSISTENT STORAGE: SUPABASE POSTGRESQL
# ------------------------------------------------------------------------------
# Public Supabase URL and anonymous key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Privileged service role key (STRICTLY SERVER-SIDE, never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 6. RATE LIMITING & SECURITY DEFENSES
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
